model User {
  id            String         @id @default(uuid())
  name          String
  email         String         @unique
  password_hash String
  role          String         // 'client' or 'provider'
  appointments  Appointment[]  @relation("ClientAppointments")
  slots         TimeSlot[]     @relation("ProviderSlots")
}

model TimeSlot {
  id           String        @id @default(uuid())
  provider_id  String
  provider     User          @relation("ProviderSlots", fields: [provider_id], references: [id])
  date         DateTime
  start_time   String
  end_time     String
  is_booked    Boolean       @default(false)
  appointment  Appointment?
}

model Appointment {
  id          String   @id @default(uuid())
  client_id   String
  client      User     @relation("ClientAppointments", fields: [client_id], references: [id])
  slot_id     String   @unique
  slot        TimeSlot @relation(fields: [slot_id], references: [id])
  status      String   @default("confirmed") // 'confirmed', 'cancelled'
  created_at  DateTime @default(now())
}